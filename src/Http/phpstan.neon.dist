parameters:
	level: 8
	treatPhpDocTypesAsCertain: false
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	paths:
		- ./
	excludePaths:
		- BaseApplication.php
		- Runner.php
		- Session.php
		- vendor/
	ignoreErrors:
		-
			identifier: trait.unused
		-
			identifier: missingType.iterableValue
		- '#Unsafe usage of new static\(\).#'
		- '#Call to static method getRequest\(\) on an unknown class Cake\\Routing\\Router.#'

		-
			message: '#^Offset ''uri'' might not exist on array\{timed_out\: bool, blocked\: bool, eof\: bool, unread_bytes\: int, stream_type\: string, wrapper_type\: string, wrapper_data\: mixed, mode\: string, \.\.\.\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: Client/FormData.php
